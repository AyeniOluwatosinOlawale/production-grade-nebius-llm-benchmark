{
  "__inputs": [],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"}],
  "annotations": {"list": []},
  "description": "LLM inference benchmark — TTFT, TPOT, tokens/s, KV-cache, GPU util, throughput, latency",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": ["mean","max","last"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "llm:ttft_p50", "legendFormat": "TTFT p50", "refId": "A"},
        {"expr": "llm:ttft_p95", "legendFormat": "TTFT p95", "refId": "B"},
        {"expr": "llm:ttft_p99", "legendFormat": "TTFT p99", "refId": "C"}
      ],
      "title": "Time to First Token (TTFT)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": ["mean","max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "llm:tpot_p50 * 1000", "legendFormat": "TPOT p50 (ms)", "refId": "A"},
        {"expr": "llm:tpot_p95 * 1000", "legendFormat": "TPOT p95 (ms)", "refId": "B"}
      ],
      "title": "Time Per Output Token (TPOT)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": ["mean","max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "llm:tokens_per_second", "legendFormat": "Tokens/s", "refId": "A"}
      ],
      "title": "Token Throughput (tokens/s)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]},
          "unit": "percentunit", "max": 1, "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {"expr": "llm:kv_cache_util", "legendFormat": "KV Cache Util", "refId": "A"}
      ],
      "title": "KV-Cache Utilisation",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 85}]},
          "unit": "percent", "max": 100, "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {"expr": "avg(DCGM_FI_DEV_GPU_UTIL{namespace=\"llm-inference\"})", "legendFormat": "Avg GPU Util %", "refId": "A"}
      ],
      "title": "GPU Utilisation %",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {"legend": {"calcs": ["mean","max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "llm:request_throughput", "legendFormat": "Req/s", "refId": "A"}
      ],
      "title": "Request Throughput (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "options": {"legend": {"calcs": ["mean","max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "llm:e2e_latency_p95", "legendFormat": "E2E p95", "refId": "A"},
        {"expr": "llm:e2e_latency_p99", "legendFormat": "E2E p99", "refId": "B"}
      ],
      "title": "E2E Latency p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 8,
      "options": {"legend": {"calcs": ["mean","max","last"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"llm-inference\",phase=\"Running\"} == 1)",
          "legendFormat": "Running Replicas",
          "refId": "A"
        },
        {
          "expr": "llm:requests_waiting",
          "legendFormat": "Requests Waiting",
          "refId": "B"
        }
      ],
      "title": "Replica Count & Queue Depth",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["llm", "benchmark", "vllm", "llm-d"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "LLM Throughput — nebius-llm-d-vllm",
  "uid": "llm-throughput-llmd-vllm",
  "version": 1
}
